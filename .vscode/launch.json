    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug TF4OT-Train",
            "type": "debugpy",
            "request": "launch",
            "module": "TF4OT.run_training",
            "justMyCode": false,
            //"python": "${command:python.interpreterPath}",
            "python": "/home/ivan/anaconda3/envs/env_TF4OT/bin/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "CUDA_VISIBLE_DEVICES": "0"
            },
            "args": [
                "--config-name",
                "TF_100K_cost_semivariable"
            ]
        },
        {
            "name": "Debug TF4OT-Inference",
            "type": "debugpy",
            "request": "launch",
            "module": "TF4OT.run_inference",
            "justMyCode": false,
            //"python": "${command:python.interpreterPath}",
            "python": "/home/ivan/anaconda3/envs/env_TF4OT/bin/python",
            "env": {
                //"PYTHONPATH": "${workspaceFolder}",
                "CUDA_VISIBLE_DEVICES": "1",
                //"CUDA_LAUNCH_BLOCKING":"1",
                //"TORCH_SHOW_CPP_STACKTRACES":"1"
            },
            "args": [
                "--config-name",
                "TF_100K_cost_fixed"
            ]
        },
        {
            "name": "Debug TF4OT-Data",
            "type": "debugpy",
            "request": "launch",
            "module": "TF4OT.run_datagenerator",
            "justMyCode": false,
            "python": "${command:python.interpreterPath}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "CUDA_VISIBLE_DEVICES": "7"
            },
            "args": [
                "--n_bins",
                "10",
                "--dataset_size",
                "100_000",
                "--output_dir",
                "./ot_dataset",
                "--repo_name",
                "ivanjaenm/ot_dataset_test"
            ]
        },
    ]
}