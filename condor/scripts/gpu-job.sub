# HTC Submit File using GPU resources
JobBatchName = "decoding4ot-$(experiment)"

universe        = container
container_image = docker://ivanjaenm/decoder4ot:v0

transfer_input_files    = ./
preserve_relative_paths = true
should_transfer_files   = YES

# Logging
stream_output  = true
stream_error   = true
output         = condor/logs/$(experiment)-$(Cluster)_output-$(Process).txt
error          = condor/logs/$(experiment)-$(Cluster)_error-$(Process).txt
log            = condor/logs/$(experiment)-$(Cluster)_log-$(Process).txt

# Enviroment vars
staging_dir  = /staging/jaenmarquez
environment  = "MPLCONFIGDIR=$(staging_dir)/.config/matplotlib WANDB_CACHE_DIR=$(staging_dir)/.config/wandb"
#LOG_DIR=$(staging_dir)

#want_campus_pools = true
#gpus_minimum_memory = 80000
#gpus_minimum_capability = 8.0

#require_gpus   = (Capability >= 7.0) && (GlobalMemoryMb >= 40000)
require_gpus   = (GlobalMemoryMb >= 40000)
request_memory = 50GB
request_gpus   = 4
request_disk   = 300GB
+GPUJobLength  = "short"
+WantGPULab    = true

executable = condor/scripts/run_experiment_training.sh
arguments  = $(experiment) \
             $(request_gpus) \
             $(Cluster)
queue 1